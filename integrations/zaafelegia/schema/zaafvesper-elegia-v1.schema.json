{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rifqifitriady/ZAAFVesper/integrations/zaafelegia/schema/zaafvesper-elegia-v1.schema.json",
  "title": "ZAAFVesper event record for ZAAFElegia, schema zaafvesper.elegia/1",
  "description": "One line of --elegia-out or of an --elegia-dir segment. Sigma field names (Image, CommandLine, DestinationIp, ...) come from pkg/sigmamap for the event's logsource category; everything ZAAFVesper adds lives under zaafvesper, so the flat namespace stays Sigma's. Every Sigma field the encoder can emit is listed with the one type it has: integers for process ids and ports, a list of strings for QueryResults, the strings true/false for booleans, strings for the rest. A field that is not listed is not allowed (adding one needs a schema review: see TestElegiaSchemaGolden).",
  "type": "object",
  "required": ["logsource", "zaafvesper"],
  "properties": {
    "logsource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {"enum": ["macos", "windows", "linux"]},
        "category": {"type": "string", "pattern": "^[a-z_]+$"}
      }
    },
    "EventID": {"type": "integer", "minimum": 1, "description": "Sysmon-compatible event id; absent for events without a Sysmon equivalent."},
    "UtcTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$", "description": "UTC, Sysmon format; ZAAFElegia reads it as the event time."},
    "Computer": {"type": "string", "description": "Host name of the sensor (Sysmon's field name)."},
    "Initiated": {"enum": ["true", "false"], "description": "network_connection: outbound (true) or inbound (false); absent for a listening socket."},
    "CallTrace": {"$ref": "#/$defs/str"},
    "CommandLine": {"$ref": "#/$defs/str"},
    "Company": {"$ref": "#/$defs/str"},
    "Consumer": {"$ref": "#/$defs/str"},
    "Contents": {"$ref": "#/$defs/str"},
    "CurrentDirectory": {"$ref": "#/$defs/str"},
    "Description": {"$ref": "#/$defs/str"},
    "Destination": {"$ref": "#/$defs/str"},
    "DestinationHostname": {"$ref": "#/$defs/str"},
    "DestinationIp": {"$ref": "#/$defs/str"},
    "Details": {"$ref": "#/$defs/str"},
    "EventNamespace": {"$ref": "#/$defs/str"},
    "EventType": {"$ref": "#/$defs/str"},
    "Filter": {"$ref": "#/$defs/str"},
    "GrantedAccess": {"$ref": "#/$defs/str"},
    "Hash": {"$ref": "#/$defs/str"},
    "Hashes": {"$ref": "#/$defs/str"},
    "Image": {"$ref": "#/$defs/str"},
    "ImageLoaded": {"$ref": "#/$defs/str"},
    "IntegrityLevel": {"$ref": "#/$defs/str"},
    "Name": {"$ref": "#/$defs/str"},
    "NewName": {"$ref": "#/$defs/str"},
    "Operation": {"$ref": "#/$defs/str"},
    "OriginalFileName": {"$ref": "#/$defs/str"},
    "ParentCommandLine": {"$ref": "#/$defs/str"},
    "ParentImage": {"$ref": "#/$defs/str"},
    "ParentProcessGuid": {"$ref": "#/$defs/str"},
    "ParentUser": {"$ref": "#/$defs/str"},
    "PipeName": {"$ref": "#/$defs/str"},
    "ProcessGuid": {"$ref": "#/$defs/str"},
    "Product": {"$ref": "#/$defs/str"},
    "Protocol": {"$ref": "#/$defs/str"},
    "Query": {"$ref": "#/$defs/str"},
    "QueryName": {"$ref": "#/$defs/str"},
    "QueryStatus": {"$ref": "#/$defs/str"},
    "Signature": {"$ref": "#/$defs/str"},
    "SignatureStatus": {"$ref": "#/$defs/str"},
    "SourceFilename": {"$ref": "#/$defs/str"},
    "SourceImage": {"$ref": "#/$defs/str"},
    "SourceIp": {"$ref": "#/$defs/str"},
    "SourceProcessGUID": {"$ref": "#/$defs/str"},
    "SourceProcessGuid": {"$ref": "#/$defs/str"},
    "SourceUser": {"$ref": "#/$defs/str"},
    "StartAddress": {"$ref": "#/$defs/str"},
    "StartFunction": {"$ref": "#/$defs/str"},
    "StartModule": {"$ref": "#/$defs/str"},
    "TargetFilename": {"$ref": "#/$defs/str"},
    "TargetImage": {"$ref": "#/$defs/str"},
    "TargetObject": {"$ref": "#/$defs/str"},
    "TargetProcessGUID": {"$ref": "#/$defs/str"},
    "TargetProcessGuid": {"$ref": "#/$defs/str"},
    "TargetUser": {"$ref": "#/$defs/str"},
    "Type": {"$ref": "#/$defs/str"},
    "User": {"$ref": "#/$defs/str"},
    "DestinationPort": {"$ref": "#/$defs/int"},
    "ParentProcessId": {"$ref": "#/$defs/int"},
    "ProcessId": {"$ref": "#/$defs/int"},
    "SourcePort": {"$ref": "#/$defs/int"},
    "SourceProcessId": {"$ref": "#/$defs/int"},
    "TargetProcessId": {"$ref": "#/$defs/int"},
    "QueryResults": {"type": "array", "items": {"type": "string"}, "description": "dns_query: the answers."},
    "Signed": {"enum": ["true", "false"], "description": "image_load, driver_load: booleans are the strings true/false, as in Sysmon."},
    "truncated": {"const": true, "description": "Present when the record was cut to its size cap."},
    "zaafvesper": {
      "type": "object",
      "required": ["schema", "name"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "zaafvesper.elegia/1"},
        "name": {"type": "string", "description": "Canonical event name (pkg/event), e.g. CreateProcess, NetworkConnect."},
        "seq": {"type": "integer", "minimum": 1},
        "source": {"type": "string", "description": "eslogger, netpoll, sysmon, zaafvesper (synthetic), ..."},
        "platform": {"enum": ["macos", "windows", "linux"]},
        "identity": {"const": "unverified", "description": "The process identity came from the kernel, not from an exec event: no signing data."},
        "proc": {"$ref": "#/$defs/proc"},
        "parent": {"$ref": "#/$defs/parent"}
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "str": {"type": "string"},
    "int": {"type": "integer"},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_platform"],
      "properties": {
        "pid": {"type": "integer"},
        "unique_id": {"type": "integer", "minimum": 1, "description": "macOS kernel per-boot unique process id (p_uniqueid)."},
        "signing_id": {"type": "string"},
        "team_id": {"type": "string"},
        "is_platform": {"type": "boolean"}
      }
    },
    "proc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_platform", "is_signed"],
      "properties": {
        "pid": {"type": "integer"},
        "pidversion": {"type": "integer"},
        "unique_id": {"type": "integer", "minimum": 1, "description": "macOS kernel per-boot unique process id (p_uniqueid); the zaafvesper pipeline maps ProcessGuid to it on macOS."},
        "signing_id": {"type": "string"},
        "team_id": {"type": "string"},
        "cs_category": {"type": "string", "description": "Code-signing validation category (platform, developer_id, app_store, local_signing, ...)."},
        "is_platform": {"type": "boolean"},
        "is_signed": {"type": "boolean"},
        "seeded": {"const": true, "description": "Learned at start-up, not from an exec event."}
      }
    }
  }
}
